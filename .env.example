# Sign-in (Better Auth). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app, e.g. https://tailor.example.com (http://localhost:3000 locally)
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may sign in: "*" for anyone with a Google account, or a comma-separated list of emails
ALLOWED_EMAILS=you@example.com,friend@example.com

# Postgres. Migrations run automatically when the server starts.
DATABASE_URL=postgres://tailor:tailor@localhost:5432/tailor
# Only for docker-compose.yml: password for its bundled Postgres (DATABASE_URL is set for you there).
POSTGRES_PASSWORD=

# Optional. Gemini keys are NOT set here: each person adds their own in Settings.
# It stays in their browser, which calls Gemini directly; the server never receives it.
# TYPST_BIN=typst

# Optional: HN Jobs page. Your own Gemini key, only for parsing public Hacker News
# "Who is hiring?" posts with Gemini 2.5 Flash-Lite (cents a month).
# GEMINI_API_KEY=
# Pin a thread instead of following the latest one each month:
# HN_HIRING_THREAD_ID=
# HN_GEMINI_MODEL=gemini-2.5-flash-lite
