# Which provider runs the model calls: anthropic | google | openai-compatible
LLM_PROVIDER=anthropic

# "fast" does extraction, fit analysis and questions. "write" tailors the resume.
# Anthropic defaults: claude-haiku-4-5 (fast), claude-sonnet-5-5 (write).
LLM_MODEL_FAST=
LLM_MODEL_WRITE=

# anthropic
ANTHROPIC_API_KEY=

# google (Gemini, has a free tier)
GOOGLE_GENERATIVE_AI_API_KEY=

# openai-compatible: Qwen, DeepSeek, OpenRouter, Ollama, ...
#   Qwen (Alibaba Model Studio): LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   OpenRouter:                  LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama (local, no key):      LLM_BASE_URL=http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=

# Storage (defaults shown)
# DATABASE_URL=./data/career.db
# TAILORED_DIR=../tailored
# PROFILE_YAML=../profile/profile.yaml
# TYPST_BIN=typst
